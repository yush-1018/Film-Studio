# ==============================================================================
# Film Studio Root Environment Configuration Template
# ==============================================================================

# NODE / GATEWAY CONFIGURATION
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/film_studio
JWT_SECRET=super-secret-jwt-key-change-in-production
CORS_ORIGIN=http://localhost:5173

# AGENT ENGINE / FASTAPI CONFIGURATION
AGENTS_SERVICE_URL=http://localhost:8000
AGENTS_HOST=0.0.0.0
AGENTS_PORT=8000
REDIS_URL=redis://localhost:6379/0

# PROVIDER CONFIGURATION (MOCK / LIVE)
DEFAULT_LLM_PROVIDER=mock
DEFAULT_STT_PROVIDER=mock
DEFAULT_TTS_PROVIDER=mock
DEFAULT_IMAGE_PROVIDER=mock
DEFAULT_VIDEO_PROVIDER=mock

# LIVE API KEYS (OPTIONAL FOR MOCK DEV)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
RUNWAY_API_KEY=
STABILITY_API_KEY=

# STORAGE / S3 / MINIO CONFIGURATION
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=film-studio-assets
S3_REGION=us-east-1
USE_SSL=false
